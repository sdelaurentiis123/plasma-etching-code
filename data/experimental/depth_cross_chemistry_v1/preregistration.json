    {
      "name": "cyclic_sf6_boundary_flux_normalization",
      "role": "reactor_boundary",
      "unit": "1",
      "lower": 0.1,
      "upper": 10.0,
      "source": "Yoshie et al. 2023 Figure 4 blanket poly-Si rates in the same reactor; facility-conditioned mode only",
      "calibration_allowed": true,
      "supports_prediction": true
    },
    {
      "name": "chlorine_dissociative_sticking_probability",
      "role": "physical_mechanism",
      "unit": "1",
      "lower": 0.01,
      "upper": 1.0,
      "source": "Chang 1998 and Levinson et al. 1997 controlled Ar+/Cl and Ar+/Cl2 beam yield curves",
      "calibration_allowed": true,
      "supports_prediction": true
    },
    {
      "name": "chlorine_atoms_removed_per_si",
      "role": "physical_mechanism",
      "unit": "Cl_atom_per_Si_atom",
      "lower": 1.0,
      "upper": 4.0,
      "source": "Levinson et al. 1997 coverage/site-balance regression, constrained by volatile SiClx stoichiometry",
      "calibration_allowed": true,
      "supports_prediction": true
    },
    {
      "name": "feature_grid_spacing",
      "role": "numerical_control",
      "unit": "nm",
      "lower": 0.25,
      "upper": 10.0,
      "source": "declared convergence ladder, never experimental calibration",
      "calibration_allowed": false,
      "supports_prediction": true
    },
    {
      "name": "transport_sample_count",
      "role": "numerical_control",
      "unit": "count",
      "lower": 1024,
      "upper": 1048576,
      "source": "declared Monte Carlo convergence ladder, never experimental calibration",
      "calibration_allowed": false,
      "supports_prediction": true
    }
  ],
